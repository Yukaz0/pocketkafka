# PocketKafka fleet-agent: one-command Docker host onboarding.
# Usage:
#   docker run -d --restart=always --name fleet-agent \
#     -v /var/run/docker.sock:/var/run/docker.sock \
#     -v fleet-agent-state:/data \
#     -e FLEET_SERVER_URL=http://<controller>:8080 \
#     -e FLEET_ENROLL_TOKEN=<single-use-token> \
#     pocketkafka-fleet-agent:latest
FROM golang:1.26-alpine AS builder
ARG TARGETOS
ARG TARGETARCH
ARG VERSION=dev
WORKDIR /app
COPY go.mod ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 \
  GOOS=${TARGETOS:-linux} \
  GOARCH=${TARGETARCH:-amd64} \
  go build \
  -trimpath \
  -ldflags="-s -w -X main.version=${VERSION:-dev}" \
  -o /app/bin/fleet-agent ./cmd/fleet-agent

FROM alpine:3.20
RUN addgroup -S fleet && adduser -S -G fleet fleet
COPY --from=builder /app/bin/fleet-agent /usr/local/bin/fleet-agent
COPY cmd/fleet-agent/docker-entrypoint.sh /usr/local/bin/docker-entrypoint.sh
RUN chmod +x /usr/local/bin/docker-entrypoint.sh \
  && mkdir -p /data && chown fleet:fleet /data
VOLUME ["/data"]
ENV FLEET_STATE_PATH=/data/agent-state.json
ENTRYPOINT ["/usr/local/bin/docker-entrypoint.sh"]
