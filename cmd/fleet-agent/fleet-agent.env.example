# PocketKafka Fleet Agent Configuration
# Salin berkas ini ke /etc/fleet-agent/agent.env atau /etc/default/fleet-agent

# URL server kontrol PocketKafka Fleet
FLEET_SERVER_URL="https://127.0.0.1:18090"

# Token enrollment sekali-pakai (hanya dibutuhkan saat pertama kali pendaftaran host)
# Setelah state tersimpan di FLEET_STATE_PATH, variabel ini aman dikosongkan.
FLEET_ENROLL_TOKEN=""

# Path CA cert untuk validasi sertifikat server kontrol (opsional bila self-signed / private CA)
# FLEET_CA_CERT="/etc/fleet-agent/ca.pem"

# Lokasi Docker daemon UNIX socket
FLEET_DOCKER_SOCKET="/var/run/docker.sock"

# Lokasi penyimpanan state kredensial agen (agent_id, server_id, secret)
FLEET_STATE_PATH="/var/lib/fleet-agent/agent-state.json"

# Flag tambahan (misalnya -insecure untuk pengujian lokal saja)
EXTRA_FLAGS=""
